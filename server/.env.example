# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/voyagehub?retryWrites=true&w=majority

# JWT Secrets (generate strong random strings)
JWT_ACCESS_SECRET=your-access-token-secret-change-me
JWT_REFRESH_SECRET=your-refresh-token-secret-change-me
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Google Gemini AI
GOOGLE_GEMINI_API_KEY=your-gemini-api-key

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# Cookie
COOKIE_SECRET=your-cookie-secret-change-me
